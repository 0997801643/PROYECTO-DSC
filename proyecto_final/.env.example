# Copiar este archivo como .env y completar con tus datos (el .env no se sube a GitHub)

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=CERVECERIA_DB
SNOWFLAKE_PRIVATE_KEY_PATH=keys/rsa_key.p8

# Llave privada en base64 para Kestra (secret('SNOWFLAKE_PRIVATE_KEY'))
SECRET_SNOWFLAKE_PRIVATE_KEY=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_EXPERIMENT=merma-cerveza

# Kestra (lee solo variables con prefijo ENV_)
ENV_SNOWFLAKE_ACCOUNT=
ENV_SNOWFLAKE_USER=
ENV_SNOWFLAKE_ROLE=
ENV_SNOWFLAKE_WAREHOUSE=
ENV_SNOWFLAKE_DATABASE=CERVECERIA_DB

# Contraseñas de la infraestructura local (docker-compose las lee de aquí)
POSTGRES_PASSWORD=
KESTRA_ADMIN_PASSWORD=